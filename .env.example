# Postgres (pgvector)
DATABASE_URL=postgresql://wine:wine@localhost:5432/wine

# ml service (Python, FastAPI)
MODEL_NAME=google/siglip2-so400m-patch14-384
DEVICE=auto            # auto | cuda | cpu
ML_PORT=8001

# web (Nuxt)
PORT=8080
ENGINE=vector          # vector | stub
ML_URL=http://127.0.0.1:8001
CONFIDENCE_MARGIN=0.03 # top1 - top2 score gap considered "confident"
NOT_FOUND_SCORE=0.72    # top1 score below this -> "not in catalog"
LABEL_WEIGHT=0.5       # search score = (1-w)*whole bottle + w*best label crop

# OCR: easyocr (local, default) | yandex (Yandex Vision OCR, cloud; needs the two values below)
OCR_PROVIDER=easyocr
YC_OCR_API_KEY=         # API key of a service account with role ai.vision.user - never commit it
YC_FOLDER_ID=           # Yandex Cloud folder id
